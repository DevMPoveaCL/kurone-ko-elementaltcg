---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { landingContent } from "@/content/landing";
import HeroReliquary from "@/components/landing/HeroReliquary.astro";
import ShowingCards from "@/components/landing/ShowingCards.astro";
import PrimordialVerdict from "@/components/landing/PrimordialVerdict.astro";
import CardTypeReliquary from "@/components/landing/CardTypeReliquary.astro";
import SacredGridAnatomy from "@/components/landing/SacredGridAnatomy.astro";
import RoadmapSealedGate from "@/components/landing/RoadmapSealedGate.astro";
import FinalCTA from "@/components/landing/FinalCTA.astro";
---

<BaseLayout
  title="Elemental Queens — Sumerian Edition"
  description="Elemental Queens is a divine tactical TCG videogame forged in the Sumerian first age. Command goddess relics, sacred symbols, and strategic devotion on a contested battlefield."
  siteName="Elemental Queens"
  ogImage="/assets/landing/hero/og-default-placeholder.webp"
  robots="index, follow"
>
  <main class="min-h-screen w-full">
    <HeroReliquary hero={landingContent.hero} sections={landingContent.sections} />

    <div class="landing-continuum">
      <div class="showing-cards-section landing-continuum-section">
        <div class="scroll-reveal">
          <ShowingCards content={landingContent.showingCards} />
        </div>
      </div>

      <div id="primordial-verdict" class="landing-viewport-section landing-viewport-section--continuum">
        <div class="scroll-reveal mx-auto flex min-h-[100svh] w-full max-w-7xl items-center px-6 py-10 lg:px-10">
          <PrimordialVerdict verdict={landingContent.primordialVerdict} />
        </div>
      </div>

      <div id="card-type-reliquary" class="landing-viewport-section landing-viewport-section--continuum">
        <div class="scroll-reveal mx-auto flex min-h-[100svh] w-full max-w-7xl items-center px-6 py-10 lg:px-10">
          <CardTypeReliquary reliquary={landingContent.cardTypeReliquary} />
        </div>
      </div>

      <div id="sacred-grid-anatomy" class="landing-viewport-section landing-viewport-section--continuum">
        <div class="scroll-reveal mx-auto flex min-h-[100svh] w-full max-w-7xl items-center px-6 py-10 lg:px-10">
          <SacredGridAnatomy anatomy={landingContent.sacredGridAnatomy} />
        </div>
      </div>

      <div id="sealed-roadmap" class="landing-viewport-section landing-viewport-section--continuum">
        <div class="scroll-reveal mx-auto flex min-h-[100svh] w-full max-w-7xl items-center px-6 py-10 lg:px-10">
          <RoadmapSealedGate roadmap={landingContent.roadmapSealedGate} />
        </div>
      </div>

      <section id="follow-first-edition" class="landing-viewport-section landing-viewport-section--continuum" aria-labelledby="final-cta-title">
        <div class="scroll-reveal mx-auto flex min-h-[100svh] w-full max-w-7xl items-center px-6 py-10 lg:px-10">
          <FinalCTA />
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    (() => {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const sections = Array.from(document.querySelectorAll(".scroll-reveal"));

      if (sections.length === 0) return;

      if (reduceMotion) {
        sections.forEach((section) => {
          if (!(section instanceof HTMLElement)) return;
          section.style.setProperty("--reveal-progress", "1");
          section.style.setProperty("--reveal-inverse", "0");
        });
        return;
      }

      document.documentElement.dataset.scrollLinkedRevealReady = "true";

      const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

      const update = () => {
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        const buildDistance = viewportHeight * 0.58;

        sections.forEach((section) => {
          if (!(section instanceof HTMLElement)) return;

          const rect = section.getBoundingClientRect();
          const rawProgress = (viewportHeight - rect.top) / buildDistance;
          const progress = clamp(rawProgress, 0, 1);
          const inverse = 1 - progress;

          section.style.setProperty("--reveal-progress", progress.toFixed(3));
          section.style.setProperty("--reveal-inverse", inverse.toFixed(3));
        });
      };

      let ticking = false;
      const requestUpdate = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      };

      update();
      window.addEventListener("scroll", requestUpdate, { passive: true });
      window.addEventListener("resize", requestUpdate);
    })();
  </script>

</BaseLayout>
