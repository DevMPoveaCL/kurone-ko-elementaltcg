---
import type { SacredGridAnatomyContent } from "@/content/landing";

interface Props {
  anatomy: SacredGridAnatomyContent;
}

const { anatomy } = Astro.props as Props;
const battlefieldHotspots = anatomy.battlefieldGuide.symbols.map((symbol) => {
  const yPercent = parseInt(symbol.y);
  return {
    ...symbol,
    tooltipDir: yPercent > 60 ? "above" : "below",
  };
});
const battlefieldSymbolsJson = JSON.stringify(anatomy.battlefieldGuide.symbols).replaceAll("<", "\\u003c");
const cardAnatomyJson = JSON.stringify(anatomy.anatomyFields).replaceAll("<", "\\u003c");
---

<section class="battlefield-content w-full" aria-labelledby="sacred-grid-anatomy-title" data-sacred-grid-anatomy-root>
  <div class="grid gap-6 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
    <div>
      <p class="text-xs uppercase tracking-[0.24em] text-metal-aged-gold-bright">{anatomy.sectionEyebrow}</p>
      <h2 id="sacred-grid-anatomy-title" class="mt-3 text-3xl font-semibold md:text-4xl">{anatomy.sectionTitle}</h2>
    </div>
    <p class="text-sm leading-7 text-surface-parchment/90 md:text-base">{anatomy.sectionDescription}</p>
  </div>

  <div class="ornate-separator mt-6" aria-hidden="true"></div>

  <div class="battlefield-showcase mt-6">
    <figure class="battlefield-arena-panel">
      <div class="showing-card-tilt battlefield-board-tilt" data-card-magnifier-runtime data-battlefield-board-tilt>
          <img
            src={anatomy.battlefieldImage.src}
            srcset={anatomy.battlefieldImage.srcSet}
            sizes={anatomy.battlefieldImage.sizes}
            alt={anatomy.battlefieldImage.alt}
            width={anatomy.battlefieldImage.width}
            height={anatomy.battlefieldImage.height}
            loading="lazy"
            decoding="async"
            class="showing-card-image battlefield-arena-image"
          />
          <img
            src={anatomy.battlefieldImage.magnifiedSrc}
            srcset={anatomy.battlefieldImage.magnifiedSrcSet}
            sizes={anatomy.battlefieldImage.magnifiedSizes}
            alt=""
            width={anatomy.battlefieldImage.magnifiedWidth}
            height={anatomy.battlefieldImage.magnifiedHeight}
            loading="lazy"
            decoding="async"
            fetchpriority="auto"
            class="showing-card-magnifier battlefield-board-magnifier"
            aria-hidden="true"
            data-battlefield-board-magnifier
            data-magnified-width={anatomy.battlefieldImage.magnifiedWidth}
            data-magnified-height={anatomy.battlefieldImage.magnifiedHeight}
          />
          <div class="battlefield-hotspot-layer" aria-label={anatomy.battlefieldGuide.title}>
            {
              battlefieldHotspots.map((hotspot, index) => (
                <div class="battlefield-hotspot battlefield-hotspot--field" data-tooltip-dir={hotspot.tooltipDir} style={`--hotspot-x:${hotspot.x};--hotspot-y:${hotspot.y};`}>
                  <button type="button" aria-label={`${hotspot.label}: ${hotspot.detail}`}>
                    <span>{index + 1}</span>
                  </button>
                </div>
              ))
            }
          </div>
        </div>
        <div class="battlefield-explanation-panel battlefield-explanation-panel--field" aria-live="polite" aria-label="Battlefield symbol explanation" data-battlefield-explanation-panel hidden>
          <div class="battlefield-explanation-active" data-explanation-content>
            <span class="battlefield-explanation-number" data-explanation-number></span>
            <div class="battlefield-explanation-content">
              <strong data-explanation-label></strong>
              <span data-explanation-position hidden></span>
              <p data-explanation-detail></p>
            </div>
          </div>
        </div>
        <figcaption class="sr-only">{anatomy.battlefieldSummary}</figcaption>
      </figure>

    <aside class="battlefield-card-anatomy" aria-label="Gilgamesh card anatomy">
      <div class="battlefield-card-stage">
        <div class="showing-card-tilt battlefield-card-tilt" data-card-magnifier-runtime data-battlefield-card-tilt>
          <img
            src={anatomy.cardImage.src}
            srcset={anatomy.cardImage.srcSet}
            sizes={anatomy.cardImage.sizes}
            alt={anatomy.cardImage.alt}
            width={anatomy.cardImage.width}
            height={anatomy.cardImage.height}
            loading="lazy"
            decoding="async"
            fetchpriority="auto"
            class="showing-card-image"
          />
          <img
            src={anatomy.cardImage.magnifiedSrc}
            srcset={anatomy.cardImage.magnifiedSrcSet}
            sizes={anatomy.cardImage.magnifiedSizes}
            alt=""
            width={anatomy.cardImage.magnifiedWidth}
            height={anatomy.cardImage.magnifiedHeight}
            loading="lazy"
            decoding="async"
            fetchpriority="auto"
            class="showing-card-magnifier"
            aria-hidden="true"
            data-battlefield-card-magnifier
            data-magnified-width={anatomy.cardImage.magnifiedWidth}
            data-magnified-height={anatomy.cardImage.magnifiedHeight}
          />
        </div>
        <div class="battlefield-hotspot-layer battlefield-hotspot-layer--card" aria-label="Gilgamesh card anatomy markers">
          {
            anatomy.anatomyFields.map((field, index) => {
              const yPercent = parseInt(field.y);
              return (
                <div class="battlefield-hotspot battlefield-hotspot--card" data-tooltip-dir={yPercent > 60 ? "above" : "below"} style={`--hotspot-x:${field.x};--hotspot-y:${field.y};`}>
                  <button type="button" aria-label={`${field.label}: ${field.detail}`}>
                    <span>{index + 1}</span>
                  </button>
                </div>
              );
            })
          }
        </div>
        <div class="battlefield-explanation-panel battlefield-explanation-panel--card" aria-live="polite" aria-label="Gilgamesh card anatomy explanation" data-card-explanation-panel hidden>
          <div class="battlefield-explanation-active" data-explanation-content>
            <span class="battlefield-explanation-number" data-explanation-number></span>
            <div class="battlefield-explanation-content">
              <strong data-explanation-label></strong>
              <span data-explanation-position hidden></span>
              <p data-explanation-detail></p>
            </div>
          </div>
        </div>
      </div>
    </aside>

    <script type="application/json" data-battlefield-symbols is:inline set:html={battlefieldSymbolsJson}></script>
    <script type="application/json" data-card-anatomy is:inline set:html={cardAnatomyJson}></script>
  </div>

  <script is:inline>
    (() => {
      const script = document.currentScript;
      const root = script instanceof HTMLElement ? script.closest("[data-sacred-grid-anatomy-root]") : null;
      if (!(root instanceof HTMLElement)) return;

      function parseDataScript(selector) {
        const dataScript = root.querySelector(selector);
        if (!dataScript) return [];

        try {
          const parsed = JSON.parse(dataScript.textContent || '[]');
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      }

      const battlefieldSymbols = parseDataScript('[data-battlefield-symbols]');
      const cardAnatomy = parseDataScript('[data-card-anatomy]');
      const battlefieldExplanationPanel = root.querySelector('[data-battlefield-explanation-panel]');
      const cardExplanationPanel = root.querySelector('[data-card-explanation-panel]');

      function showExplanation(panel, source, index) {
        const item = source[index];
        if (!item || !(panel instanceof HTMLElement)) return;

        const numEl = panel.querySelector('[data-explanation-number]');
        const strongEl = panel.querySelector('[data-explanation-label]');
        const positionEl = panel.querySelector('[data-explanation-position]');
        const pEl = panel.querySelector('[data-explanation-detail]');

        if (numEl) numEl.textContent = String(index + 1);
        if (strongEl) strongEl.textContent = item.label;
        if (positionEl instanceof HTMLElement) {
          positionEl.textContent = item.position || '';
          positionEl.hidden = !item.position;
        }
        if (pEl) pEl.textContent = item.detail;
        panel.hidden = false;
      }

      function hideExplanation(panel) {
        if (!(panel instanceof HTMLElement)) return;
        panel.hidden = true;
        const numEl = panel.querySelector('[data-explanation-number]');
        const strongEl = panel.querySelector('[data-explanation-label]');
        const positionEl = panel.querySelector('[data-explanation-position]');
        const pEl = panel.querySelector('[data-explanation-detail]');
        if (numEl) numEl.textContent = '';
        if (strongEl) strongEl.textContent = '';
        if (positionEl instanceof HTMLElement) {
          positionEl.textContent = '';
          positionEl.hidden = true;
        }
        if (pEl) pEl.textContent = '';
      }

      root.querySelectorAll('.battlefield-hotspot--field button').forEach((btn, index) => {
        btn.addEventListener('mouseenter', () => {
          hideExplanation(cardExplanationPanel);
          showExplanation(battlefieldExplanationPanel, battlefieldSymbols, index);
        });
        btn.addEventListener('focus', () => {
          hideExplanation(cardExplanationPanel);
          showExplanation(battlefieldExplanationPanel, battlefieldSymbols, index);
        });
        btn.addEventListener('mouseleave', () => hideExplanation(battlefieldExplanationPanel));
        btn.addEventListener('blur', () => hideExplanation(battlefieldExplanationPanel));
      });

      root.querySelectorAll('.battlefield-hotspot--card button').forEach((btn, index) => {
        btn.addEventListener('mouseenter', () => {
          hideExplanation(battlefieldExplanationPanel);
          showExplanation(cardExplanationPanel, cardAnatomy, index);
        });
        btn.addEventListener('focus', () => {
          hideExplanation(battlefieldExplanationPanel);
          showExplanation(cardExplanationPanel, cardAnatomy, index);
        });
        btn.addEventListener('mouseleave', () => hideExplanation(cardExplanationPanel));
        btn.addEventListener('blur', () => hideExplanation(cardExplanationPanel));
      });

      root.querySelector('.battlefield-arena-panel')?.addEventListener('focusout', (event) => {
        if (event.currentTarget instanceof HTMLElement && event.relatedTarget instanceof Node && event.currentTarget.contains(event.relatedTarget)) return;
        hideExplanation(battlefieldExplanationPanel);
      });

      root.querySelector('.battlefield-card-anatomy')?.addEventListener('focusout', (event) => {
        if (event.currentTarget instanceof HTMLElement && event.relatedTarget instanceof Node && event.currentTarget.contains(event.relatedTarget)) return;
        hideExplanation(cardExplanationPanel);
      });
    })();
  </script>
  <script>
    import { installCardMagnifierRuntime } from "./magnifierRuntime";

    installCardMagnifierRuntime(document);
  </script>
</section>
