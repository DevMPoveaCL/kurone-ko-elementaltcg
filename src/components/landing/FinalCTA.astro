---
import { newsletterContent } from "@/content/newsletter";
import NewsletterForm from "@/components/landing/NewsletterForm.astro";
---

<section id="follow-first-edition" class="reliquary-panel scroll-mt-8" aria-labelledby="final-cta-title">
  <p class="text-xs uppercase tracking-[0.24em] text-metal-aged-gold-bright">Final Invocation</p>
  <h2 id="final-cta-title" class="mt-3 text-3xl font-semibold">{newsletterContent.formTitle}</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-surface-parchment/90 md:text-base">
    {newsletterContent.formDescription}
  </p>

  <div class="ornate-separator mt-6" aria-hidden="true"></div>

  <NewsletterForm />
</section>
