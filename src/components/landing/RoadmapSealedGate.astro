---
import type { RoadmapSealedGateContent } from "@/content/landing";

interface Props {
  roadmap: RoadmapSealedGateContent;
}

const { roadmap } = Astro.props as Props;
---

<section class="roadmap-sealed-gate w-full py-2 md:py-4" aria-labelledby="sealed-roadmap-title">
  <p class="text-xs uppercase tracking-[0.24em] text-metal-aged-gold-bright">{roadmap.sectionEyebrow}</p>
  <h2 id="sealed-roadmap-title" class="mt-3 max-w-4xl text-3xl font-semibold md:text-4xl">{roadmap.sectionTitle}</h2>
  <p class="mt-4 max-w-4xl text-sm leading-7 text-surface-parchment/90 md:text-base">{roadmap.sectionDescription}</p>

  <div class="ornate-separator mt-7" aria-hidden="true"></div>

  <ol class="sealed-roadmap-list mt-7 grid list-none gap-4 p-0 md:grid-cols-2" aria-label="Elemental Queens roadmap">
    {
      roadmap.phases.map((phase) => (
        <li class="rounded-xl border border-metal-bronze/45 bg-surface-obsidian/62 p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="text-xs uppercase tracking-[0.2em] text-metal-aged-gold-bright">{phase.label}</p>
            <span class="rounded-full border border-metal-bronze/45 px-3 py-1 text-xs text-surface-parchment/78">{phase.status}</span>
          </div>
          <h3 class="mt-3 text-xl font-semibold">{phase.title}</h3>
          <p class="mt-3 text-sm leading-7 text-surface-parchment/88">{phase.detail}</p>
        </li>
      ))
    }
  </ol>

  <p class="mt-6 rounded-lg border border-metal-aged-gold/45 bg-metal-aged-gold/10 px-4 py-3 text-sm leading-7 text-metal-aged-gold-bright">{roadmap.finalLine}</p>
</section>
