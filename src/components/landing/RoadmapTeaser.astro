---
import type { RoadmapTeaserContent } from "@/content/landing";

interface Props {
  roadmap: RoadmapTeaserContent;
}

const { roadmap } = Astro.props as Props;
---

<section id="future-eras-teaser" class="reliquary-panel scroll-mt-8" aria-labelledby="roadmap-teaser-title">
  <p class="text-xs uppercase tracking-[0.24em] text-metal-aged-gold-bright">{roadmap.sectionEyebrow}</p>
  <h2 id="roadmap-teaser-title" class="mt-3 text-3xl font-semibold">{roadmap.sectionTitle}</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-surface-parchment/90 md:text-base">{roadmap.sectionDescription}</p>

  <div class="ornate-separator mt-6" aria-hidden="true"></div>

  <p class="energy-glow-accent mt-6 rounded-md border border-metal-bronze/45 bg-surface-obsidian/58 px-4 py-3 text-sm text-surface-parchment/90">
    {roadmap.teaserLine}
  </p>
</section>
