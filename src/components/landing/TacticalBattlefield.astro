---
import type { TacticalBattlefieldContent } from "@/content/landing";

interface Props {
  battlefield: TacticalBattlefieldContent;
}

const { battlefield } = Astro.props as Props;
---

<section id="tactical-battlefield" class="reliquary-panel scroll-mt-8" aria-labelledby="tactical-battlefield-title">
  <p class="text-xs uppercase tracking-[0.24em] text-metal-aged-gold-bright">{battlefield.sectionEyebrow}</p>
  <h2 id="tactical-battlefield-title" class="mt-3 text-3xl font-semibold">{battlefield.sectionTitle}</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-surface-parchment/90 md:text-base">{battlefield.sectionDescription}</p>

  <div class="ornate-separator mt-6" aria-hidden="true"></div>

  <div class="board-grid-accent energy-glow-accent mt-7 rounded-2xl border border-metal-bronze/45 bg-surface-obsidian/55 p-4">
  <ul class="grid list-none gap-3 p-0 md:grid-cols-3" aria-label="Battlefield proof points">
    {
      battlefield.proofPoints.map((point) => (
        <li class="rounded-lg border border-metal-bronze/45 bg-surface-calm/78 px-4 py-3 text-sm text-surface-parchment/90 backdrop-blur-sm">
          {point}
        </li>
      ))
    }
  </ul>
  </div>

  <p class="mt-5 rounded-md border border-dashed border-metal-bronze/50 bg-surface-calm/75 px-4 py-3 text-xs text-surface-parchment/85">
    Placeholder board visual: /src/assets/landing/board/ (awaiting approved render)
  </p>
</section>
