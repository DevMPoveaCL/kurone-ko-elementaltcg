---
import type { CardTypeReliquaryContent } from "@/content/landing";

interface Props {
  reliquary: CardTypeReliquaryContent;
}

const { reliquary } = Astro.props as Props;
const activeType = reliquary.cardTypes[0];
const serializedTypes = JSON.stringify(reliquary.cardTypes).replace(/</g, "\\u003c");

if (!activeType) {
  throw new Error("CardTypeReliquary requires at least one card type.");
}

const trailingTypeOne = reliquary.cardTypes[1] ?? activeType;
const trailingTypeTwo = reliquary.cardTypes[2] ?? trailingTypeOne;
---

<section
  class="card-type-reliquary-content w-full"
  aria-labelledby="card-type-reliquary-title"
  aria-roledescription="carousel"
  role="region"
  data-card-type-root
>
  <div class="grid gap-6 lg:grid-cols-[0.82fr_1.18fr] lg:items-end">
    <div>
      <p class="text-xs uppercase tracking-[0.24em] text-metal-aged-gold-bright">{reliquary.sectionEyebrow}</p>
      <h2 id="card-type-reliquary-title" class="mt-3 text-3xl font-semibold md:text-4xl">{reliquary.sectionTitle}</h2>
    </div>
    <p class="text-sm leading-7 text-surface-parchment/90 md:text-base">{reliquary.sectionDescription}</p>
  </div>

  <div class="ornate-separator mt-6" aria-hidden="true"></div>

  <div class="mt-6 grid gap-7 lg:grid-cols-[minmax(0,0.92fr)_minmax(17rem,0.68fr)] lg:items-center">
    <aside
      class="card-type-lore"
      aria-live="polite"
      data-card-type-lore
      data-transitioning="false"
      data-motion-ready="false"
    >
      <p class="text-xs uppercase tracking-[0.24em] text-metal-aged-gold-bright" data-card-type-eyebrow>{reliquary.sectionEyebrow}</p>
      <h3 class="mt-3 text-3xl font-semibold" data-card-type-title>{activeType.slot}</h3>
      <p class="mt-2 text-sm uppercase tracking-[0.2em] text-surface-parchment/85" data-card-type-subtitle>{activeType.subtitle}</p>
      <p class="mt-5 text-base leading-relaxed text-metal-aged-gold-bright" data-card-type-question>{activeType.question}</p>
      <p class="mt-4 text-base leading-8 text-surface-parchment/90" data-card-type-detail>{activeType.detail}</p>

      <nav class="showing-card-navigation" aria-label="Sacred Typology navigation">
        <button
          class="showing-card-control showing-card-control--lore showing-card-control--previous"
          type="button"
          aria-label="Show previous card type"
          data-card-type-previous
        >
          <span aria-hidden="true">←</span>
        </button>

        <div class="showing-card-dots" aria-label="Card type positions">
          {
            reliquary.cardTypes.map((cardType, index) => (
              <button
                class="showing-card-dot"
                type="button"
                aria-label={`Show ${cardType.slot}`}
                aria-current={index === 0 ? "true" : "false"}
                aria-pressed={index === 0 ? "true" : "false"}
                data-card-type-dot
                data-card-index={index}
              >
                <span class="sr-only">{cardType.slot}</span>
              </button>
            ))
          }
        </div>

        <button
          class="showing-card-control showing-card-control--lore showing-card-control--next"
          type="button"
          aria-label="Show next card type"
          data-card-type-next
        >
          <span aria-hidden="true">→</span>
        </button>
      </nav>

      <p class="sr-only" data-card-type-live>Now showing {activeType.slot}</p>
    </aside>

    <div class="card-type-stage" data-card-type-stage>
      <img
        src={trailingTypeOne.image.trailingSrc}
        srcset={trailingTypeOne.image.srcSet}
        sizes={trailingTypeOne.image.trailingSizes}
        alt=""
        width={trailingTypeOne.image.width}
        height={trailingTypeOne.image.height}
        loading="lazy"
        decoding="async"
        fetchpriority="auto"
        class="showing-card-image showing-card-trailing showing-card-trailing--1"
        aria-hidden="true"
        data-card-type-slot="trailing-1"
      />
      <img
        src={trailingTypeTwo.image.trailingSrc}
        srcset={trailingTypeTwo.image.srcSet}
        sizes={trailingTypeTwo.image.trailingSizes}
        alt=""
        width={trailingTypeTwo.image.width}
        height={trailingTypeTwo.image.height}
        loading="lazy"
        decoding="async"
        fetchpriority="auto"
        class="showing-card-image showing-card-trailing showing-card-trailing--2"
        aria-hidden="true"
        data-card-type-slot="trailing-2"
      />
      <div class="showing-card-tilt card-type-tilt" data-card-type-tilt>
        <img
          src={activeType.image.src}
          srcset={activeType.image.srcSet}
          sizes={activeType.image.sizes}
          alt={activeType.image.alt}
          width={activeType.image.width}
          height={activeType.image.height}
          loading="lazy"
          decoding="async"
          fetchpriority="auto"
          class="showing-card-image showing-card-buffer"
          data-card-type-buffer="a"
          data-buffer-active="true"
          aria-hidden="false"
        />
        <img
          src={activeType.image.src}
          srcset={activeType.image.srcSet}
          sizes={activeType.image.sizes}
          alt=""
          width={activeType.image.width}
          height={activeType.image.height}
          loading="lazy"
          decoding="async"
          fetchpriority="auto"
          class="showing-card-image showing-card-buffer"
          data-card-type-buffer="b"
          data-buffer-active="false"
          aria-hidden="true"
        />
        <img
          src={activeType.image.magnifiedSrc}
          srcset={activeType.image.magnifiedSrcSet}
          sizes={activeType.image.magnifiedSizes}
          alt=""
          width={activeType.image.magnifiedWidth}
          height={activeType.image.magnifiedHeight}
          loading="lazy"
          decoding="async"
          fetchpriority="auto"
          class="showing-card-magnifier"
          aria-hidden="true"
          data-card-type-magnifier
        />
      </div>
    </div>
  </div>

  <script is:inline type="application/json" data-card-type-data set:html={serializedTypes}></script>

  <script is:inline>
    (() => {
      const roots = document.querySelectorAll("[data-card-type-root]");

      roots.forEach((root) => {
        if (!(root instanceof HTMLElement)) return;

        const dataScript = root.querySelector("[data-card-type-data]");
        const buffers = Array.from(root.querySelectorAll("[data-card-type-buffer]"));
        const trailingImages = Array.from(root.querySelectorAll("[data-card-type-slot^='trailing-']"));
        const tilt = root.querySelector("[data-card-type-tilt]");
        const magnifier = root.querySelector("[data-card-type-magnifier]");
        const lore = root.querySelector("[data-card-type-lore]");
        const title = root.querySelector("[data-card-type-title]");
        const subtitle = root.querySelector("[data-card-type-subtitle]");
        const question = root.querySelector("[data-card-type-question]");
        const detail = root.querySelector("[data-card-type-detail]");
        const live = root.querySelector("[data-card-type-live]");
        const previous = root.querySelector("[data-card-type-previous]");
        const next = root.querySelector("[data-card-type-next]");
        const dots = Array.from(root.querySelectorAll("[data-card-type-dot]"));

        if (
          !(dataScript instanceof HTMLScriptElement) ||
          buffers.length !== 2 ||
          !buffers.every((buffer) => buffer instanceof HTMLImageElement) ||
          !(tilt instanceof HTMLElement) ||
          !(magnifier instanceof HTMLImageElement) ||
          !(lore instanceof HTMLElement) ||
          !(title instanceof HTMLElement) ||
          !(subtitle instanceof HTMLElement) ||
          !(question instanceof HTMLElement) ||
          !(detail instanceof HTMLElement) ||
          !(live instanceof HTMLElement) ||
          !(previous instanceof HTMLButtonElement) ||
          !(next instanceof HTMLButtonElement)
        ) {
          return;
        }

        let cardTypes;
        try {
          cardTypes = JSON.parse(dataScript.textContent || "[]");
        } catch {
          return;
        }

        if (!Array.isArray(cardTypes) || cardTypes.length === 0) return;

        let activeIndex = 0;
        let activeBufferIndex = 0;
        let renderRequest = 0;

        const wait = (duration) => new Promise((resolve) => window.setTimeout(resolve, duration));
        const nextFrame = () => new Promise((resolve) => window.requestAnimationFrame(resolve));
        const prefersAnimatedSwap = window.matchMedia("(prefers-reduced-motion: no-preference)");
        const loreItems = [title, subtitle, question, detail];

        const setMotionReady = () => {
          lore.dataset.motionReady = String(prefersAnimatedSwap.matches);
        };

        const setLoreStagger = () => {
          loreItems.forEach((item, itemIndex) => item.style.setProperty("--lore-delay", `${itemIndex * 40}ms`));
        };

        const getWrappedType = (index) => cardTypes[(index + cardTypes.length) % cardTypes.length];

        const preloadImage = async (cardType) => {
          if (!cardType || !cardType.image || !cardType.image.src) return;
          const preload = new Image();
          preload.src = cardType.image.src;
          if (cardType.image.srcSet) preload.srcset = cardType.image.srcSet;
          if (cardType.image.sizes) preload.sizes = cardType.image.sizes;
          if (typeof preload.decode === "function") await preload.decode().catch(() => undefined);
        };

        const preloadAdjacent = (index) => {
          void preloadImage(getWrappedType(index - 1));
          void preloadImage(getWrappedType(index + 1));
        };

        const updateLoreContent = (cardType) => {
          if (!cardType || !cardType.image) return;
          title.textContent = cardType.slot;
          subtitle.textContent = cardType.subtitle;
          question.textContent = cardType.question;
          detail.textContent = cardType.detail;
          live.textContent = `Now showing ${cardType.slot}`;

          dots.forEach((dot, dotIndex) => {
            if (!(dot instanceof HTMLButtonElement)) return;
            const isActive = dotIndex === activeIndex;
            dot.setAttribute("aria-current", String(isActive));
            dot.setAttribute("aria-pressed", String(isActive));
          });
        };

        const updateTrailingCards = () => {
          trailingImages.forEach((trailingImage, trailingIndex) => {
            if (!(trailingImage instanceof HTMLImageElement)) return;
            const trailingType = getWrappedType(activeIndex + trailingIndex + 1);
            if (!trailingType || !trailingType.image) return;
            trailingImage.src = trailingType.image.trailingSrc || trailingType.image.src;
            trailingImage.srcset = trailingType.image.srcSet || "";
            trailingImage.sizes = trailingType.image.trailingSizes || trailingType.image.sizes || "";
            trailingImage.width = trailingType.image.width;
            trailingImage.height = trailingType.image.height;
          });
        };

        const flipBuffer = (cardType) => {
          const nextBufferIndex = activeBufferIndex === 0 ? 1 : 0;
          const currentBuffer = buffers[activeBufferIndex];
          const nextBuffer = buffers[nextBufferIndex];
          if (!(currentBuffer instanceof HTMLImageElement) || !(nextBuffer instanceof HTMLImageElement)) return;

          nextBuffer.src = cardType.image.src;
          nextBuffer.srcset = cardType.image.srcSet || "";
          nextBuffer.sizes = cardType.image.sizes || "";
          nextBuffer.alt = cardType.image.alt;
          nextBuffer.width = cardType.image.width;
          nextBuffer.height = cardType.image.height;
          nextBuffer.setAttribute("aria-hidden", "false");
          nextBuffer.dataset.bufferActive = "true";

          magnifier.src = cardType.image.magnifiedSrc || cardType.image.src;
          magnifier.srcset = cardType.image.magnifiedSrcSet || cardType.image.srcSet || "";
          magnifier.sizes = cardType.image.magnifiedSizes || cardType.image.sizes || "";
          magnifier.width = cardType.image.magnifiedWidth || cardType.image.width;
          magnifier.height = cardType.image.magnifiedHeight || cardType.image.height;

          currentBuffer.setAttribute("aria-hidden", "true");
          currentBuffer.dataset.bufferActive = "false";
          activeBufferIndex = nextBufferIndex;
        };

        const render = async (index) => {
          activeIndex = (index + cardTypes.length) % cardTypes.length;
          const cardType = cardTypes[activeIndex];
          if (!cardType || !cardType.image) return;

          const requestId = renderRequest + 1;
          renderRequest = requestId;

          if (!prefersAnimatedSwap.matches) {
            lore.dataset.transitioning = "false";
            await preloadImage(cardType);
            if (requestId !== renderRequest) return;
            updateLoreContent(cardType);
            updateTrailingCards();
            flipBuffer(cardType);
            preloadAdjacent(activeIndex);
            return;
          }

          lore.dataset.motionReady = "true";
          setLoreStagger();
          await preloadImage(cardType);
          if (requestId !== renderRequest) return;

          lore.dataset.transitioning = "true";
          await nextFrame();
          if (requestId !== renderRequest) return;

          updateLoreContent(cardType);
          updateTrailingCards();
          await wait(60);
          if (requestId !== renderRequest) return;

          flipBuffer(cardType);
          await wait(30);
          if (requestId !== renderRequest) return;

          lore.dataset.transitioning = "false";
          preloadAdjacent(activeIndex);
        };

        setMotionReady();
        if (typeof prefersAnimatedSwap.addEventListener === "function") prefersAnimatedSwap.addEventListener("change", setMotionReady);
        preloadAdjacent(activeIndex);

        previous.addEventListener("click", () => render(activeIndex - 1));
        next.addEventListener("click", () => render(activeIndex + 1));

        dots.forEach((dot) => {
          if (!(dot instanceof HTMLButtonElement)) return;
          dot.addEventListener("click", () => render(Number.parseInt(dot.dataset.cardIndex || "0", 10)));
        });

        root.addEventListener("keydown", (event) => {
          if (!(event instanceof KeyboardEvent)) return;
          if (!root.contains(document.activeElement)) return;
          if (event.key === "ArrowLeft") {
            event.preventDefault();
            render(activeIndex - 1);
          }
          if (event.key === "ArrowRight") {
            event.preventDefault();
            render(activeIndex + 1);
          }
        });

        const canMagnify = window.matchMedia("(prefers-reduced-motion: no-preference)").matches &&
          window.matchMedia("(hover: hover)").matches &&
          window.matchMedia("(pointer: fine)").matches;

        if (!canMagnify) return;

        let frame = 0;
        let pointerX = 50;
        let pointerY = 50;
        let isPointerInside = false;

        const applyMagnifier = () => {
          const rotateY = (pointerX - 50) * 0.16;
          const rotateX = (50 - pointerY) * 0.14;
          tilt.style.setProperty("--tilt-x", `${rotateX.toFixed(2)}deg`);
          tilt.style.setProperty("--tilt-y", `${rotateY.toFixed(2)}deg`);
          tilt.style.setProperty("--glare-x", `${pointerX.toFixed(2)}%`);
          tilt.style.setProperty("--glare-y", `${pointerY.toFixed(2)}%`);
          frame = 0;
        };

        const setMagnifierState = (active) => {
          tilt.dataset.magnifying = String(active);
        };

        const resolveStableMagnifierState = () => {
          if (tilt.dataset.magnifying === "true") return pointerX >= 5 && pointerX <= 95 && pointerY >= 5 && pointerY <= 95;
          return pointerX >= 9 && pointerX <= 91 && pointerY >= 9 && pointerY <= 91;
        };

        tilt.addEventListener("pointerenter", () => {
          isPointerInside = true;
        }, { passive: true });

        tilt.addEventListener("pointermove", (event) => {
          const rect = tilt.getBoundingClientRect();
          pointerX = Math.min(Math.max(((event.clientX - rect.left) / rect.width) * 100, 0), 100);
          pointerY = Math.min(Math.max(((event.clientY - rect.top) / rect.height) * 100, 0), 100);
          setMagnifierState(isPointerInside && resolveStableMagnifierState());
          if (frame === 0) frame = window.requestAnimationFrame(applyMagnifier);
        }, { passive: true });

        tilt.addEventListener("pointerleave", () => {
          isPointerInside = false;
          setMagnifierState(false);
          tilt.style.setProperty("--tilt-x", "0deg");
          tilt.style.setProperty("--tilt-y", "0deg");
          tilt.style.setProperty("--glare-x", "50%");
          tilt.style.setProperty("--glare-y", "18%");
        });
      });
    })();
  </script>
</section>
