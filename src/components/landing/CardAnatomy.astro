---
import type { CardAnatomyContent } from "@/content/landing";
import { ELEMENT } from "@/content/landing";
import CardFrame from "@/components/landing/CardFrame.astro";

interface Props {
  anatomy: CardAnatomyContent;
}

const { anatomy } = Astro.props as Props;
---

<section id="card-anatomy" class="reliquary-panel scroll-mt-8" aria-labelledby="card-anatomy-title">
  <p class="text-xs uppercase tracking-[0.24em] text-metal-aged-gold-bright">{anatomy.sectionEyebrow}</p>
  <h2 id="card-anatomy-title" class="mt-3 text-3xl font-semibold">{anatomy.sectionTitle}</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-surface-parchment/90 md:text-base">{anatomy.sectionDescription}</p>

  <div class="ornate-separator mt-6" aria-hidden="true"></div>

  <!-- Anatomy diagram — CardFrame rendered as visual reference with exact draft slots -->
  <div class="mt-7 flex flex-col items-center gap-6 md:flex-row md:items-start">
    <div class="w-full max-w-sm shrink-0">
      <CardFrame
        element={ELEMENT.WATER}
        illustration="/assets/cards/nammu/card.webp"
        name="Nammu"
        role="Abyssal Memory"
        symbol="Tide Seal"
        shortLore="Keeper of primordial waters and hidden tides."
        ability="Memory — The first sea remembers every sacrifice."
        isAnatomy={true}
      />
    </div>

    <!-- Anatomy field annotations -->
    <dl class="grid gap-3 md:grid-cols-1">
      {
        anatomy.fields.map((field) => (
          <div class="reliquary-card p-3">
            <dt class="text-sm font-semibold uppercase tracking-[0.1em] text-metal-aged-gold">{field.label}</dt>
            <dd class="mt-1 text-sm leading-relaxed text-surface-parchment/90">{field.detail}</dd>
          </div>
        ))
      }
      <!-- Additional annotation for card anatomy slots -->
      <div class="reliquary-card p-3">
        <dt class="text-sm font-semibold uppercase tracking-[0.1em] text-metal-aged-gold">Frame Anatomy</dt>
          <dd class="mt-1 text-sm leading-relaxed text-surface-parchment/90">
          The exact draft frame reads as a reliquary: seal medallion (top-left), cost medallion
          (top-right), centered name strip, illustration window, lore panel, rank medallion
          (bottom-left), and attribute medallion (bottom-right), all driven by OKLCH element tokens.
        </dd>
      </div>
    </dl>
  </div>
</section>
