---
import type { DivinePathsContent, GoddessCardContent } from "@/content/landing";
import { IMAGE_OPTIMIZATION } from "@/content/landing";

interface Props {
  intro: DivinePathsContent;
  paths: GoddessCardContent[];
}

const { intro, paths } = Astro.props as Props;
---

<section id="four-divine-paths" class="reliquary-panel scroll-mt-8" aria-labelledby="divine-paths-title">
  <p class="text-xs uppercase tracking-[0.24em] text-metal-aged-gold-bright">{intro.sectionEyebrow}</p>
  <h2 id="divine-paths-title" class="mt-3 text-3xl font-semibold">{intro.sectionTitle}</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-surface-parchment/90 md:text-base">{intro.sectionDescription}</p>

  <div class="ornate-separator mt-6" aria-hidden="true"></div>

  <ul class="mt-8 grid list-none gap-4 p-0 md:grid-cols-2" aria-label="The four elemental goddess paths">
    {
      paths.map((path) => {
        // Optimization preset — unused until <Image /> replaces placeholder
        void (IMAGE_OPTIMIZATION[path.optimizationKey] as unknown);
        return (
          <li class="reliquary-card p-5">
            <p class="text-xs uppercase tracking-[0.2em] text-metal-aged-gold-bright">{path.symbol}</p>
            <h3 class="mt-2 text-2xl font-semibold">{path.name}</h3>
            <p class="mt-1 text-sm font-medium text-surface-parchment/90">{path.role}</p>
            <p class="mt-3 text-sm leading-relaxed text-surface-parchment/90">{path.shortLore}</p>
            <p class="energy-glow-accent mt-4 rounded-md border border-metal-bronze/40 bg-surface-calm/75 px-3 py-2 text-xs text-surface-parchment/85">
              Placeholder render: {path.cardImage}
              <!--
                IMAGE OPTIMIZATION READINESS — swap when {path.name} render is Approved:
                import { Image } from "astro:assets";
                <Image
                  src={pathOpt.src}
                  alt={pathOpt.altFallback}
                  width={pathOpt.width}
                  height={pathOpt.height}
                  loading={pathOpt.loading}
                  fetchpriority={pathOpt.fetchpriority}
                  decoding={pathOpt.decoding}
                  class="mt-4 rounded-lg w-full"
                />
              -->
            </p>
          </li>
        );
      })
    }
  </ul>
</section>
