---
import type { PrimordialVerdictContent } from "@/content/landing";

interface Props {
  verdict: PrimordialVerdictContent;
}

const { verdict } = Astro.props as Props;
---

<section id="primordial-verdict" class="reliquary-panel scroll-mt-8" aria-labelledby="primordial-verdict-title">
  <p class="text-xs uppercase tracking-[0.24em] text-metal-aged-gold-bright">{verdict.sectionEyebrow}</p>
  <h2 id="primordial-verdict-title" class="mt-3 max-w-4xl text-3xl font-semibold md:text-4xl">{verdict.sectionTitle}</h2>
  <p class="mt-4 max-w-4xl text-base leading-8 text-surface-parchment/90 md:text-lg">{verdict.sectionDescription}</p>

  <div class="ornate-separator mt-7" aria-hidden="true"></div>

  <ol class="mt-7 grid list-none gap-4 p-0 md:grid-cols-2" aria-label="Primordial game rules">
    {
      verdict.ruleTiers.map((rule, index) => (
        <li class="primordial-rule-card rounded-xl border border-metal-bronze/45 bg-surface-obsidian/60 p-5">
          <p class="text-xs uppercase tracking-[0.22em] text-metal-aged-gold-bright">Rite {index + 1}</p>
          <h3 class="mt-2 text-xl font-semibold">{rule.title}</h3>
          <p class="mt-3 text-sm leading-7 text-surface-parchment/88">{rule.detail}</p>
        </li>
      ))
    }
  </ol>
</section>
